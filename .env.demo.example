# ---------------------------------------------------------------------------
# Investor-demo overrides — copy the lines you need into your root .env, then
# restart the backend. See docs/DEMO_RUNBOOK.md for the full walkthrough.
# .env itself is git-ignored; this template is safe to commit (no secrets).
# ---------------------------------------------------------------------------

# REQUIRED — without this the whole Admin console 403s. The admin role is
# minted on first touch of an admin endpoint by an allow-listed email; there
# is no seeded admin row. JSON-array syntax; use the LOWERCASED sign-in email.
ADMIN_EMAILS=["you@example.com"]

# Richer demo: seed a journal/analytics history on a cold DB (DB-only, so it
# works after-hours / on a weekend).
SEED_TRADES=1

# Keep the human-review flows demonstrable (default is auto in sim mode):
#  - payouts otherwise auto-approve after 1h and leave the queue empty
#  - KYC otherwise auto-verifies and never sits at `pending`
PAYOUT_AUTO_APPROVE=0
KYC_AUTO_VERIFY=0

# ONLY if you serve over plain HTTP on a LAN IP / hostname, or use Safari.
# The Docker image bakes APP_ENV=production -> Secure session cookie, which
# browsers drop over http:// on a non-localhost origin (instant logout).
# Leave unset when running the dev servers on localhost.
# COOKIE_SECURE=0
