# Alpaca
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_PAPER=true
ALPACA_OPTIONS_FEED=indicative

# Finnhub
FINNHUB_API_KEY=your_key_here

# FRED
FRED_API_KEY=your_key_here

# Optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=options-dashboard/0.1

# Stripe (OPT-IN — leave blank to keep the free placeholder purchase flow).
# Per-tier prices are Stripe Price IDs (price_…); no dollar amounts live in
# code. STRIPE_WEBHOOK_SECRET is the signing secret Stripe shows per endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_50K=
STRIPE_PRICE_100K=
STRIPE_PRICE_150K=
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?purchase=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard?purchase=cancelled

# App config
DATABASE_URL=sqlite:///./data/dashboard.db
LOG_LEVEL=INFO

# Offsite backups (OPT-IN — leave the provider at "none" and nothing is sent
# anywhere). The nightly snapshot lands in data/backups, which on the deploy
# is the SAME volume as the live database; setting a provider mirrors each
# snapshot to object storage so losing that volume is survivable. Works with
# Cloudflare R2 (region "auto", endpoint https://<account>.r2.cloudflarestorage.com),
# Backblaze B2, MinIO, or bare AWS S3 (leave the endpoint blank).
# With the provider set to "s3" an incomplete configuration FAILS the backup
# job loudly rather than silently not replicating. See docs/DEPLOYMENT.md.
BACKUP_OFFSITE_PROVIDER=none
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 0 = the app never deletes a remote object (prefer a bucket lifecycle rule).
BACKUP_OFFSITE_RETENTION_DAYS=0

# Deployment posture. APP_ENV=production hardens several defaults on its own:
# the session cookie gets Secure, and PAYOUT_AUTO_APPROVE / KYC_AUTO_VERIFY
# both default OFF (a human adjudicates payouts and identity documents).
# Setting either to 1 in production restores the simulated behaviour and the
# startup preflight will say so on every boot. See "Configuration preflight"
# in docs/DEPLOYMENT.md.
APP_ENV=development
# PAYOUT_AUTO_APPROVE=
# KYC_AUTO_VERIFY=
