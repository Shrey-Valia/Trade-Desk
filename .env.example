# Alpaca
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_PAPER=true
ALPACA_OPTIONS_FEED=indicative

# Finnhub
FINNHUB_API_KEY=your_key_here

# FRED
FRED_API_KEY=your_key_here

# Optional
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=options-dashboard/0.1

# Stripe (OPT-IN — leave blank to keep the free placeholder purchase flow).
# Per-tier prices are Stripe Price IDs (price_…); no dollar amounts live in
# code. STRIPE_WEBHOOK_SECRET is the signing secret Stripe shows per endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_50K=
STRIPE_PRICE_100K=
STRIPE_PRICE_150K=
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?purchase=success
STRIPE_CANCEL_URL=http://localhost:5173/dashboard?purchase=cancelled

# App config
DATABASE_URL=sqlite:///./data/dashboard.db
LOG_LEVEL=INFO
