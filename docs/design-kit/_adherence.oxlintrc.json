{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "ui_kits/combine/**",
              "ui_kits/data/**",
              "ui_kits/funded/**",
              "ui_kits/terminal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:intent|label|sub|disabled|key|ref|className|style|children)$/]",
        "message": "<ActionButton> doesn't accept that prop. Declared props: intent, label, sub, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|active|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, active, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChainRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:strike|call|put|isAtm|callSource|putSource|onCall|onPut|onStrike|disabled|key|ref|className|style|children)$/]",
        "message": "<ChainRow> doesn't accept that prop. Declared props: strike, call, put, isAtm, callSource, putSource, onCall, onPut, onStrike, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|tone|signed|sub|width|key|ref|className|style|children)$/]",
        "message": "<MetricPill> doesn't accept that prop. Declared props: label, value, tone, signed, sub, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='PresetChips'] > JSXAttribute > JSXIdentifier[name!=/^(?:presets|value|onSelect|key|ref|className|style|children)$/]",
        "message": "<PresetChips> doesn't accept that prop. Declared props: presets, value, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, onChange, min, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='TierPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|breached|key|ref|className|style|children)$/]",
        "message": "<TierPill> doesn't accept that prop. Declared props: tier, breached."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "ActionButton": {
        "replaces": []
      },
      "Badge": {
        "replaces": []
      },
      "Button": {
